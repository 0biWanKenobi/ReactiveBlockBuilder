{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"entry": ["src/routes/**/+*.{js,ts,svelte}", "scripts/*.{mjs,ts}"],
	"project": ["src/**/*.{js,ts,svelte}", "*.{js,ts}"],
	"paths": {
		"#lib": ["./src/lib/index.ts"],
		"#lib/*": ["./src/lib/*"]
	},
	"ignoreDependencies": ["prettier"],
	"svelte": true,
	"sveltekit": true
}
