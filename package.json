{
  "name": "reactiveblockbuilder",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@0biwankenobi/dice-wasm": "https://github.com/0biWanKenobi/dice-wasm/releases/download/v0.2.1/dice-wasm-v0.2.1.tgz",
    "@0biwankenobi/dice-wasm": "https://github.com/0biWanKenobi/dice-wasm/releases/download/v0.2.1/dice-wasm-v0.2.1.tgz",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-json": "^6.0.2",
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-document": "^3.35.0",
    "@tiptap/extension-text": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "codemirror": "^6.0.2",
    "mathjs": "^15.2.0",
    "prettier": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-auto": "^8.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "prettier-plugin-svelte": "^4.2.0",
    "publint": "^0.3.25",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-wasm": "^3.6.0"
  },
  "keywords": [
    "svelte",
    "tiptap",
    "character-sheet",
    "block-editor"
  ],
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
